# VPS production — copy to backend/.env (no AWS required)
#
# Profile photos & uploads use local disk + API route:
#   GET /api/v1/media/file/{user_id}/{filename}

# --- Storage (local disk) ---
STORAGE_TYPE=local
# Docker (docker-compose.yml mounts media_data → /app/storage):
LOCAL_STORAGE_PATH=/app/storage
# Bare metal (no Docker) — use a path on the VPS that survives reboots:
# LOCAL_STORAGE_PATH=/var/lib/myhigh5/media

# Public API origin (must match how browsers reach FastAPI)
BACKEND_PUBLIC_URL=https://api.myhigh5.com
# If API is only on myhigh5.com/api (no api subdomain), use:
# BACKEND_PUBLIC_URL=https://myhigh5.com

FRONTEND_URL=https://myhigh5.com

# --- NOWPayments (crypto checkout) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=usdtbsc
NOWPAYMENTS_UNDERPAYMENT_TOLERANCE_USD=0.5
# IPN callback URL (auto): {BACKEND_PUBLIC_URL}/api/v1/webhooks/nowpayments

# --- NOWPayments affiliate payouts (auto-pay commissions) ---
NOWPAYMENTS_PAYOUT_API_KEY=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_PAYOUT_TOTP_SECRET=

# --- KYC (Kaluta — default) ---
KYC_PROVIDER=kaluta
KALUTA_API_KEY=
KALUTA_WEBHOOK_SECRET=
# Optional overrides (defaults: {BACKEND_PUBLIC_URL}/api/v1/kyc/webhook/kaluta, {FRONTEND_URL}/dashboard/kyc)
# KALUTA_WEBHOOK_URL=
# KALUTA_REDIRECT_URL=

# Legacy Shufti Pro (only if KYC_PROVIDER=shufti_pro):
# SHUFTI_CLIENT_ID=
# SHUFTI_SECRET_KEY=

# --- Do NOT set these on VPS unless you switch back to S3 ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# =============================================================================
# Database — single source of truth for API, migrations, and deploy scripts.
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/myhigh5

# =============================================================================
# Required when ENVIRONMENT=production (auto-generated by scripts/ensure_backend_env_secrets.sh)
# =============================================================================
ENVIRONMENT=production
SECRET_KEY=change-me-long-random-string-min-32-chars
MASTER_ENCRYPTION_KEY=
ENCRYPTION_KEY_DERIVATION_SALT=
BACKEND_CORS_ORIGINS=https://myhigh5.com,https://www.myhigh5.com

# ========================================
# Email (Resend) - see Admin > Email Settings
# ========================================
# Bootstrap / fallback API key. An Admin may store an override (encrypted) instead.
RESEND_API_KEY=
# Signing secret of the Resend webhook (starts with whsec_; shown once when the webhook is created in the
# Resend dashboard). NOT the API key. Empty = POST /api/v1/webhooks/resend accepts nothing (503).
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=MyHigh5 <infos@myhigh5.com>
# REQUIRED for email. Dedicated secret (32+ random characters): the only key
# used to encrypt queued email payloads and the Admin API-key override. If it
# is missing, no email is queued (Admin > Email Settings shows "Configuration
# required"); the rest of the site is unaffected. Never reuse SECRET_KEY or
# MASTER_ENCRYPTION_KEY here, and keep it stable once set.
# Outbox executor: the backend process itself (USE_CELERY unset/false), or the
# Celery worker + beat when USE_CELERY=true. Never both.
EMAIL_SETTINGS_ENCRYPTION_KEY=
# Optional: verified sender domains (comma separated). Empty = domain of EMAIL_FROM.
EMAIL_ALLOWED_FROM_DOMAINS=

# --- Dual cashout of affiliate commissions (app/services/payment_config.py) ---
# Thresholds, fees, limits, the wallet hold and the cashout switches are managed
# in Admin > Finance & Payments and stored in the database. The two lines below
# are SERVER MASTER SWITCHES that the Admin Panel cannot override: money leaves
# only when the server switch AND the Admin switch are both on.
#
# Automatic crypto payouts. Leave false until custody, the payout wallet, the
# server IP whitelist and reconciliation have been verified and the owner has
# authorised live payouts.
CRYPTO_AUTO_PAYOUT_ENABLED=false
# Recording that a USD cashout was paid. Leave false until a USD payout channel exists.
USD_CASHOUT_SETTLEMENT_ENABLED=false
#
# Dedicated secret that encrypts provider credentials stored through the Admin
# Panel (AES-256-GCM). At least 32 characters, generated for this purpose only
# (e.g. `openssl rand -base64 48`), never stored in the database and never
# reused from another secret. Without it no credential can be stored or read.
# Changing it makes the stored credentials unreadable: they must be stored again.
PAYMENT_SETTINGS_ENCRYPTION_KEY=
#
# Seed values only: used as the defaults until the first change is saved in the
# Admin Panel, ignored afterwards.
# CRYPTO_CASHOUT_MIN_USD=1.00
# USD_CASHOUT_MIN_USD=100.00
# PAYOUT_WALLET_HOLD_HOURS=72
# PAYOUT_WALLET_MAX_CHANGES_PER_DAY=3
# CASHOUT_ENGINE_INTERVAL_SECONDS=900
# CASHOUT_RETRY_BACKOFF_HOURS=24
# USD_CASHOUT_SETTLEMENT_ACCOUNT=
# Members examined per payout cycle (operational, not a business setting).
# CASHOUT_ENGINE_BATCH_LIMIT=25
