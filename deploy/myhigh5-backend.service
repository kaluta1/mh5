[Unit]
Description=MyHigh5 FastAPI backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/mh5/backend
EnvironmentFile=/root/mh5/backend/.env
Environment=PYTHONPATH=/root/mh5/backend
ExecStart=/root/mh5/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1 --timeout-keep-alive 30
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
